# Vireel backend -- environment variables.
#
# Copy to .env and fill in real values. Nothing here is a working secret;
# every value is either a placeholder or the same default the code already
# falls back to when the variable is unset.

# ---------------------------------------------------------------------------
# Referral program (section 3 of the spec) -- the backend is the sole
# source of truth for these; the frontend always reads them back from
# GET /api/referrals/config instead of hardcoding a copy. Changing one of
# these only ever affects rewards granted AFTER the change -- a reward
# already granted keeps whatever amount/expiry it was given with.
# ---------------------------------------------------------------------------
REFERRAL_SIGNUP_BONUS_CREDITS=50
REFERRAL_MONTHLY_BONUS_CREDITS=100
REFERRAL_ANNUAL_BONUS_CREDITS=300
PROMOTIONAL_CREDITS_EXPIRATION_DAYS=60
# There is no signup webhook/trigger in this codebase (accounts are
# created directly by the frontend's Supabase Auth SDK call) -- this is
# the grace window the referral-association endpoint uses to verify an
# account is genuinely brand new rather than an existing user
# retroactively attaching a referrer. See get_auth_user_created_at.
REFERRAL_ASSOCIATION_WINDOW_MINUTES=60
# Shared secret required (as the X-Admin-Secret header) to call the
# administrative referral-invalidation endpoint. Leave unset to disable
# that endpoint entirely (it 403s with no secret configured).
ADMIN_API_SECRET=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Stripe (billing)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Overdraft ceiling in credits -- 0 (default) disallows any debt.
MAX_CREDIT_DEBT=0
STORAGE_OVERAGE_TOLERANCE_PERCENT=10

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=
FRONTEND_ORIGIN=
CORS_ALLOWED_ORIGINS=
BASE_URL=

# ---------------------------------------------------------------------------
# Auth / crypto secrets
# ---------------------------------------------------------------------------
SECRET_KEY=
ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Email (Brevo)
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@vireel.co

# ---------------------------------------------------------------------------
# Storage (S3)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSLATE_MODEL=
OPENAI_BAD_TAKE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TRANSLATE_MODEL=
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Social platform OAuth (publishing integrations)
# ---------------------------------------------------------------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CLIENT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DIRECT_POST_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Jobs / scheduling
# ---------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=
MAX_ACTIVE_JOBS_PER_USER=
QUEUE_WORKER_COUNT=
SOCIAL_PUBLISH_SCHEDULER_INTERVAL_SECONDS=10
ANNUAL_CREDIT_REFILL_INTERVAL_SECONDS=86400
OUTPUT_SWEEP_INTERVAL_SECONDS=21600
OUTPUT_SWEEP_MIN_AGE_SECONDS=1800

# ---------------------------------------------------------------------------
# Feature flags / misc limits
# ---------------------------------------------------------------------------
DISABLE_YOUTUBE_URL=false
HIDE_SOCIAL_PLATFORMS=false
ANONYMOUS_STORIES_ENABLED=
FILM_SUMMARY_ENABLED=
DEMO_ALLOWED_EMAILS=
